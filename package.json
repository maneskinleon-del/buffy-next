{
  "name": "buffy",
  "version": "0.1.0",
  "description": "Asistente técnico de diagnóstico y asistencia para sistemas operativos",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "buffy": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["diagnostic", "system", "assistant", "windows", "android", "termux"],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
